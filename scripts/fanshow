    def _get_drawer_led_cache(self):
        """Build a cache of drawer_name -> led_status from FAN_DRAWER_INFO table."""
        cache = {}
        drawer_keys = self.db.keys(self.db.STATE_DB, FAN_DRAWER_TABLE_NAME + '*')
        if not drawer_keys:
            return cache
        for key in drawer_keys:
            key_list = key.split('|')
            if len(key_list) != 2:
                print('Warn: Invalid key in table FAN_DRAWER_INFO: {}'.format(key))
                continue
            drawer_name = key_list[1]
            data_dict = self.db.get_all(self.db.STATE_DB, key)
            led = data_dict.get(LED_STATUS_FIELD_NAME, '')
            if led:
                cache[drawer_name] = led
        return cache

    def _get_fan_led(self, data_dict, drawer_led_cache):
        """Get LED status for a fan, falling back to drawer LED if per-fan LED is N/A."""
        led = data_dict.get(LED_STATUS_FIELD_NAME, '')
        if led:
            return led
        drawer_name = data_dict.get(DRAWER_FIELD_NAME, 'N/A')
        return drawer_led_cache.get(drawer_name, 'N/A')

    def _parent_psu_power_state(self, fan_name):
        """For a PSU fan (e.g. 'PSU3_FAN1'), return its parent PSU's power state
        ('absent' / 'unpowered' / 'faulted' / 'ok') using the shared classifier.
        Returns None for non-PSU fans or when the PSU row is missing."""
        match = re.match(r'^PSU\s*(\d+)_FAN', fan_name)
        if not match:
            return None
        idx = match.group(1)
        for psu_key in ('PSU{}'.format(idx), 'PSU {}'.format(idx)):
            data = self.db.get_all(self.db.STATE_DB, '{}|{}'.format(PSU_TABLE_NAME, psu_key))
            if data:
                return classify_psu_power(data)
        return None

